{
  "name": "lfs101-notes",
  "description": "Personal study notes from the Introduction to Linux (LFS101) course by the Linux Foundation",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp -r out/. .",
    "build:render": "next build",
    "postbuild:render": "cp -r out/. .",
    "render:build": "next build && cp -r out/. .",
    "start": "npx serve out",
    "lint": "next lint"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.10",
    "sass": "^1.89.1",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
